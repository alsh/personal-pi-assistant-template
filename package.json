{
  "name": "personal-pi-assistant",
  "version": "0.3.0",
  "type": "module",
  "description": "Privacy-conscious local personal assistant Pi package with autonomous assistant-owned text-memory writes, bounded pa_retrieve_context, and confirmation-gated document tools.",
  "keywords": [
    "pi-package",
    "personal-assistant",
    "documents",
    "text-memory",
    "zettelkasten"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node scripts/test-stage1.mjs",
    "doctor": "./scripts/doctor.sh",
    "check:policy": "./scripts/check-policy.sh",
    "check:permissions": "./scripts/check-permissions.sh",
    "check": "npm test && npm run check:policy && npm run check:permissions",
    "test:package": "./scripts/test-package-smoke.sh"
  }
}
